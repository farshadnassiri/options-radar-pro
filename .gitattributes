# پایان‌خط، یک‌بار برای همیشه.
#
# بدون این فایل، ویندوز با `core.autocrlf=true` هر فایل متنی را با CRLF
# روی دیسک می‌گذارد. آزمون‌های این مخزن متنِ منبع را با الگو می‌سنجند و
# چند تایشان `\n` را صریح در الگو دارند — یعنی سیزده قابلیتِ سالم روی
# ویندوز «خراب» گزارش می‌شدند و `node tests/run.mjs` که پیش از هر پوش
# الزامی است، هرگز سبز نمی‌شد.
#
# `eol=lf` یعنی مهم نیست تنظیم گیتِ توسعه‌دهنده چیست: checkout همیشه LF
# است، روی هر سیستم‌عاملی.
* text=auto eol=lf

# دودویی‌ها هرگز دست نمی‌خورند
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
